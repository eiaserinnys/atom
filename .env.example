# Optional PostgreSQL connection. Leave commented to use SQLite.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/atom_db
API_PORT=4200
NODE_ENV=development
JWT_SECRET=

# Local development only. Never expose a server with AUTH_BYPASS=1 to a network.
AUTH_BYPASS=

# Optional server-side Jev judgment for opt-in engine=jev searches (JSON v2 or REST stream=1 SSE)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=

# Google OAuth — leave GOOGLE_CLIENT_ID empty to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain/api/auth/google/callback

# Slack OAuth — leave SLACK_CLIENT_ID empty to disable Slack login
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=https://your-domain/api/auth/slack/callback
SLACK_ALLOWED_TEAM_ID=

# Frontend URL for CORS and OAuth redirects (required when enabling OAuth)
FRONTEND_URL=

# Optional published search-motion page URL. Leave empty to disable this page's API access.
SEARCH_MOTION_PAGE_URL=

# First admin user email (seeded on first startup)
ALLOWED_EMAIL=your-email@gmail.com
