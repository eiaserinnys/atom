# Optional PostgreSQL connection. Leave commented to use SQLite.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/atom_db
API_PORT=4200
# Optional listen host; defaults to loopback in bypass mode and all interfaces otherwise.
API_HOST=
# Optional dashboard build directory served by the API.
DASHBOARD_DIR=
# Administrator password for dashboard login; `npm run setup` writes it here. Ignored when an OAuth provider is configured.
# The server does not start unless a password, an OAuth provider, or AUTH_BYPASS=1 is configured.
DASHBOARD_ADMIN_PASSWORD=
NODE_ENV=development
# Signs browser sessions; `npm run setup` generates it when empty.
JWT_SECRET=

# Development on this computer only: no sign-in, every request runs as admin, and the server listens on 127.0.0.1.
# Not for real use, and it cannot be combined with a password or an OAuth provider.
AUTH_BYPASS=

# Optional server-side Jev judgment for opt-in engine=jev searches (JSON v2 or REST stream=1 SSE)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=

# Google OAuth — leave GOOGLE_CLIENT_ID empty to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain/api/auth/google/callback

# Slack OAuth — leave SLACK_CLIENT_ID empty to disable Slack login
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=https://your-domain/api/auth/slack/callback
SLACK_ALLOWED_TEAM_ID=

# Frontend URL for CORS and OAuth redirects (required when enabling OAuth)
FRONTEND_URL=

# Optional published search-motion page URL. Leave empty to disable this page's API access.
SEARCH_MOTION_PAGE_URL=

# First admin user email. Set your own email before the first start; empty or your-email@... is skipped.
ALLOWED_EMAIL=
